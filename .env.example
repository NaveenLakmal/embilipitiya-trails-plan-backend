PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Database configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# S3-compatible storage
AWS_ENDPOINT_URL_S3="https://<endpoint>.storage.<region>.aws.neon.tech"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-central-1"
S3_BUCKET_NAME="places-image-bucket"

# Email configuration (SMTP with Gmail or other provider)
# For Gmail, SMTP_PASS must be a 16-character Google App Password (not your Gmail account password).
# Note: Google App Password name/label (e.g. "EmbiTrail Backend") is purely an account label in Google,
# not an SMTP credential or setting in this configuration.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=EmbiTrail
MAIL_FROM_ADDRESS=

# JWT and Cryptographic Secrets
# Generate independent 256-bit random secrets locally:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_CHALLENGE_SECRET=
OTP_HASH_SECRET=

# Optional initial admin provisioning credentials for npm run seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
